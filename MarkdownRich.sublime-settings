// Full documentation: https://github.com/dportalesr/sublime-markdown-rich
// Mermaid options in detail: docs/mermaid.md
{
    // --- images -------------------------------------------------------------

    // Render images automatically when a Markdown file loads.
    "auto_show_on_load": true,

    // Size images start at: "thumbnail", "medium", or "original".
    "default_size": "thumbnail",

    // Download and render remote http(s) images.
    "render_remote": true,

    // Thumbnail size: longest side capped to this many pixels.
    "thumbnail_width": 180,

    // Medium size: scaled to fit within these bounds.
    "max_image_width": 800,
    "max_image_height": 600,

    // Drop "medium" when its width is within this fraction of the original. 0 keeps all three.
    "medium_merge_threshold": 0.1,

    // Extensions treated as images (svg excluded: minihtml can't render it).
    "image_extensions": [".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp"],

    // Cache folder name, under the OS temp dir, for downloads and diagram renders.
    "remote_cache_dirname": "SublimeMarkdownRich",

    // Token for private GitHub images. Sent only to github.com / *.githubusercontent.com,
    // and dropped on cross-host redirects. "Contents: read" is enough.
    "github_token": "",

    // Read that token from a file instead, kept outside synced settings. Wins over github_token.
    "github_token_file": "",

    // Accent color for the inline loading / missing / failed notes.
    "status_color": "#c0863a",

    // --- links and navigation -----------------------------------------------

    // Open file links beside the Markdown, by selecting both sheets in the same group.
    // Local files only, and sheet selection needs build 4050+.
    "open_link_side_by_side": true,

    // Hovering a §-reference previews the heading it points at, as a clickable link.
    "section_ref_popup": true,

    // --- syntax -------------------------------------------------------------

    // Generate a "MarkdownRich" syntax that highlights fenced code for every installed
    // language, not just the ones Sublime's Markdown covers. Written to Packages/User.
    "generate_markdown_syntax": true,

    // Syntax it inherits from. MultiMarkdown's keeps its metadata block as well.
    "markdown_syntax_parent": "Packages/Markdown/Markdown.sublime-syntax",

    // --- mermaid diagrams ---------------------------------------------------

    // Fold ```mermaid blocks and render the diagram in their place.
    "render_mermaid": true,

    // Path to the mermaid-cli binary. Empty looks for "mmdc" on PATH, extended with the
    // homebrew / asdf / volta / nvm bin dirs a GUI app doesn't inherit.
    "mermaid_cli_path": "",

    // Fall back to a Kroki server when mermaid-cli is missing or fails.
    // NOTE: this sends the diagram source to the endpoint below.
    "mermaid_remote_fallback": true,
    "mermaid_remote_endpoint": "https://kroki.io",

    // "auto" follows the color scheme, so dark schemes get mermaid's dark theme.
    // Otherwise: "default", "dark", "neutral", "forest".
    "mermaid_theme": "auto",

    // "transparent" keeps the render's alpha, so the editor shows through. "auto" bakes
    // in the color scheme's background, for opening the cached PNGs elsewhere.
    "mermaid_background": "transparent",

    // Device pixel ratio to render at. 2 is crisp on retina and is what "Open image" shows.
    "mermaid_scale": 2,

    // Inline width: a fraction of the view, pixels above 1, or 0 to fill it.
    "mermaid_max_width": 0.66,

    // Smallest height a diagram is drawn at, so wide flowcharts stay legible. 0 disables.
    "mermaid_min_height": 200,

    // Space between a node's text and its border, across every diagram type that
    // supports one. 0 keeps mermaid's own defaults. See docs/mermaid.md for the list.
    "mermaid_node_padding": 16,

    // Mermaid's own config, merged over the above one level deep. Anything valid in a
    // %%{init: ...}%% directive works, e.g.
    //   {"fontFamily": "Menlo", "flowchart": {"nodeSpacing": 60, "curve": "basis"}}
    "mermaid_config": {},

    // CSS file applied to the rendered page, for what the config can't express.
    // Local renders only. e.g. "~/.config/markdown_rich/mermaid.css"
    "mermaid_css_file": "",

    // --- troubleshooting ----------------------------------------------------

    // Log fetches and renders to the console: backend, timing, cache keys.
    // Toggle from the palette with "MarkdownRich: Toggle debug logging".
    "debug": false
}
